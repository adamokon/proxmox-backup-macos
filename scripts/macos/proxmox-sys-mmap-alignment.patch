+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::{Read, Seek, SeekFrom, Write};
+
+    #[test]
+    fn maps_4096_byte_header_on_native_page_size() {
+        let root = std::env::temp_dir().join(format!("proxmox-mmap-{}", std::process::id()));
+        std::fs::create_dir(&root).unwrap();
+        let path = root.join("index");
+        let mut file = std::fs::OpenOptions::new()
+            .create_new(true)
+            .read(true)
+            .write(true)
+            .open(&path)
+            .unwrap();
+        file.write_all(&vec![0x5a; 8192]).unwrap();
+        let mut map = unsafe {
+            Mmap::<u64>::map_fd(
+                &file,
+                4096,
+                3,
+                mman::ProtFlags::PROT_READ | mman::ProtFlags::PROT_WRITE,
+                mman::MapFlags::MAP_SHARED,
+            )
+            .unwrap()
+        };
+        assert_eq!(map.len(), 3);
+        assert_eq!(map[0], 0x5a5a5a5a5a5a5a5a);
+        map[2] = 0x1122334455667788;
+        map.msync(mman::MsFlags::MS_SYNC).unwrap();
+        drop(map);
+        file.seek(SeekFrom::Start(4096 + 16)).unwrap();
+        let mut value = [0; 8];
+        file.read_exact(&mut value).unwrap();
+        assert_eq!(u64::from_ne_bytes(value), 0x1122334455667788);
+        assert!(
+            unsafe {
+                Mmap::<u64>::map_fd(
+                    &file,
+                    4097,
+                    3,
+                    mman::ProtFlags::PROT_READ,
+                    mman::MapFlags::MAP_PRIVATE,
+                )
+            }
+            .is_err()
+        );
+        assert!(
+            unsafe {
+                Mmap::<u64>::map_fd(
+                    &file,
+                    0,
+                    usize::MAX,
+                    mman::ProtFlags::PROT_READ,
+                    mman::MapFlags::MAP_PRIVATE,
+                )
+            }
+            .is_err()
+        );
+        drop(file);
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
