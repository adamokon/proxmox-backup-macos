+pub const MAX_ATTRIBUTES: usize = 4096;
+pub const MAX_PAYLOAD: u64 = 1 << 40;
+pub const DARWIN_XATTR: u32 = 1;
+pub const WINDOWS_SECURITY: u32 = 0x10001;
+pub const WINDOWS_REPARSE: u32 = 0x10002;
+pub const WINDOWS_STREAM: u32 = 0x10003;
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct DarwinAce {
+    pub principal: [u8; 16],
+    pub kind: u32,
+    pub flags: u32,
+    pub permissions: u64,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct DarwinMetadata {
+    pub birth_seconds: i64,
+    pub birth_nanoseconds: u32,
+    pub flags: u32,
+    /// None means ACLs were excluded; Some(empty) means an explicitly empty ACL.
+    pub acl: Option<(u32, Vec<DarwinAce>)>,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct WindowsMetadata {
+    pub attributes: u32,
+    /// Native FILETIME ticks, including values outside the POSIX timestamp range.
+    pub creation_time: u64,
+    pub access_time: u64,
+    pub write_time: u64,
+    pub change_time: u64,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum PlatformMetadata {
+    Darwin(DarwinMetadata),
+    Windows(WindowsMetadata),
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum PayloadLocation {
+    /// A local, authenticated stream, addressed by digest, supplied to the encoder.
+    Source,
+    /// Payload header offset within the unified archive.
+    Archive(u64),
+    /// Payload header offset within the split .ppxar stream.
+    Payload(u64),
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NativeAttribute {
+    pub kind: u32,
+    pub name: Vec<u8>,
+    pub size: u64,
+    pub digest: [u8; 32],
+    pub location: PayloadLocation,
+}
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NativeMetadata {
+    pub platform: PlatformMetadata,
+    pub attributes: Vec<NativeAttribute>,
+}
+
+/// Application-owned encrypted storage. PXAR never creates plaintext temporary files.
+pub trait PayloadStore: Send + Sync {
+    fn reader(&self, digest: [u8; 32], size: u64) -> io::Result<Box<dyn Read + Send>>;
+    fn writer(&self, digest: [u8; 32], size: u64) -> io::Result<Box<dyn PayloadWriter>>;
+}
+pub trait PayloadWriter: Write + Send {
+    /// Verify length/digest/authentication before publishing the stored payload.
+    fn finish(self: Box<Self>) -> io::Result<()>;
+}
+
+fn invalid() -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, "invalid native PXAR metadata")
+}
+struct Cursor<'a>(&'a [u8]);
+impl Cursor<'_> {
+    fn bytes<const N: usize>(&mut self) -> io::Result<[u8; N]> {
+        if self.0.len() < N {
+            return Err(invalid());
+        }
+        let value = self.0[..N].try_into().unwrap();
+        self.0 = &self.0[N..];
+        Ok(value)
+    }
+    fn u32(&mut self) -> io::Result<u32> {
+        Ok(u32::from_le_bytes(self.bytes()?))
+    }
+    fn u64(&mut self) -> io::Result<u64> {
+        Ok(u64::from_le_bytes(self.bytes()?))
+    }
+    fn end(self) -> io::Result<()> {
+        if self.0.is_empty() {
+            Ok(())
+        } else {
+            Err(invalid())
+        }
+    }
+}
+fn u32out(out: &mut Vec<u8>, v: u32) {
+    out.extend_from_slice(&v.to_le_bytes());
+}
+fn u64out(out: &mut Vec<u8>, v: u64) {
+    out.extend_from_slice(&v.to_le_bytes());
+}
+
+impl NativeMetadata {
+    pub fn header(&self) -> io::Result<Vec<u8>> {
+        self.validate()?;
+        let mut out = Vec::new();
+        u32out(&mut out, 1); // extension schema
+        match &self.platform {
+            PlatformMetadata::Darwin(m) => {
+                u32out(&mut out, 1);
+                u64out(&mut out, m.birth_seconds as u64);
+                u32out(&mut out, m.birth_nanoseconds);
+                u32out(&mut out, m.flags);
+                u32out(&mut out, u32::from(m.acl.is_some()));
+                u32out(&mut out, m.acl.as_ref().map_or(0, |a| a.0));
+                u32out(&mut out, m.acl.as_ref().map_or(0, |a| a.1.len() as u32));
+                if let Some((_, entries)) = &m.acl {
+                    for e in entries {
+                        out.extend_from_slice(&e.principal);
+                        u32out(&mut out, e.kind);
+                        u32out(&mut out, e.flags);
+                        u64out(&mut out, e.permissions);
+                    }
+                }
+            }
+            PlatformMetadata::Windows(m) => {
+                u32out(&mut out, 2);
+                u32out(&mut out, m.attributes);
+                for t in [m.creation_time, m.access_time, m.write_time, m.change_time] {
+                    u64out(&mut out, t);
+                }
+            }
+        }
+        Ok(out)
+    }
+    pub fn from_header(data: &[u8]) -> io::Result<Self> {
+        if data.len() > MAX_HEADER {
+            return Err(invalid());
+        }
+        let mut c = Cursor(data);
+        if c.u32()? != 1 {
+            return Err(invalid());
+        }
+        let platform = match c.u32()? {
+            1 => {
+                let birth_seconds = c.u64()? as i64;
+                let birth_nanoseconds = c.u32()?;
+                let flags = c.u32()?;
+                let present = c.u32()?;
+                let acl_flags = c.u32()?;
+                let count = c.u32()?;
+                if present > 1 || count > 128 || (present == 0 && (count != 0 || acl_flags != 0)) {
+                    return Err(invalid());
+                }
+                let mut entries = Vec::new();
+                for _ in 0..count {
+                    entries.push(DarwinAce {
+                        principal: c.bytes()?,
+                        kind: c.u32()?,
+                        flags: c.u32()?,
+                        permissions: c.u64()?,
+                    });
+                }
+                PlatformMetadata::Darwin(DarwinMetadata {
+                    birth_seconds,
+                    birth_nanoseconds,
+                    flags,
+                    acl: (present == 1).then_some((acl_flags, entries)),
+                })
+            }
+            2 => PlatformMetadata::Windows(WindowsMetadata {
+                attributes: c.u32()?,
+                creation_time: c.u64()?,
+                access_time: c.u64()?,
+                write_time: c.u64()?,
+                change_time: c.u64()?,
+            }),
+            _ => return Err(invalid()),
+        };
+        c.end()?;
+        let result = Self {
+            platform,
+            attributes: Vec::new(),
+        };
+        result.validate()?;
+        Ok(result)
+    }
+    pub fn validate(&self) -> io::Result<()> {
+        if self.attributes.len() > MAX_ATTRIBUTES {
+            return Err(invalid());
+        }
+        if let PlatformMetadata::Darwin(m) = &self.platform {
+            if m.birth_nanoseconds >= 1_000_000_000
+                || m.acl.as_ref().is_some_and(|(_, es)| {
+                    es.len() > 128 || es.iter().any(|e| !matches!(e.kind, 1 | 2))
+                })
+            {
+                return Err(invalid());
+            }
+        }
+        let mut names = std::collections::HashSet::new();
+        for a in &self.attributes {
+            if a.size > MAX_PAYLOAD || !names.insert((a.kind, &a.name)) {
+                return Err(invalid());
+            }
+            match &self.platform {
+                PlatformMetadata::Darwin(_)
+                    if a.kind == DARWIN_XATTR
+                        && !a.name.is_empty()
+                        && a.name.len() <= 127
+                        && !a.name.contains(&0) =>
+                {
+                    ()
+                }
+                PlatformMetadata::Windows(_)
+                    if matches!(a.kind, WINDOWS_SECURITY | WINDOWS_REPARSE)
+                        && a.name.is_empty()
+                        && a.size <= MAX_HEADER as u64 =>
+                {
+                    ()
+                }
+                PlatformMetadata::Windows(_)
+                    if a.kind == WINDOWS_STREAM && valid_stream_name(&a.name) =>
+                {
+                    ()
+                }
+                _ => return Err(invalid()),
+            }
+            if let PayloadLocation::Archive(o) | PayloadLocation::Payload(o) = a.location {
+                o.checked_add(16)
+                    .and_then(|o| o.checked_add(a.size))
+                    .ok_or_else(invalid)?;
+            }
+        }
+        Ok(())
+    }
+}
+fn valid_stream_name(name: &[u8]) -> bool {
+    !name.is_empty()
+        && name.len() <= 510
+        && name.len() % 2 == 0
+        && std::char::decode_utf16(
+            name.chunks_exact(2)
+                .map(|x| u16::from_le_bytes([x[0], x[1]])),
+        )
+        .all(|c| c.is_ok_and(|c| !matches!(c, '\0' | '/' | '\\' | ':')))
+}
+impl NativeAttribute {
+    pub fn descriptor(&self) -> io::Result<Vec<u8>> {
+        let (kind, offset) = match self.location {
+            PayloadLocation::Archive(o) => (0, o),
+            PayloadLocation::Payload(o) => (1, o),
+            PayloadLocation::Source => return Err(invalid()),
+        };
+        let mut out = Vec::new();
+        u32out(&mut out, self.kind);
+        u32out(&mut out, kind);
+        u64out(&mut out, offset);
+        u64out(&mut out, self.size);
+        out.extend_from_slice(&self.digest);
+        out.extend_from_slice(&self.name);
+        Ok(out)
+    }
+    pub fn from_descriptor(data: &[u8]) -> io::Result<Self> {
+        if data.len() > 56 + 510 {
+            return Err(invalid());
+        }
+        let mut c = Cursor(data);
+        let kind = c.u32()?;
+        let storage = c.u32()?;
+        let offset = c.u64()?;
+        let size = c.u64()?;
+        let digest = c.bytes()?;
+        let location = match storage {
+            0 => PayloadLocation::Archive(offset),
+            1 => PayloadLocation::Payload(offset),
+            _ => return Err(invalid()),
+        };
+        Ok(Self {
+            kind,
+            name: c.0.to_vec(),
+            size,
+            digest,
+            location,
+        })
+    }
+}
