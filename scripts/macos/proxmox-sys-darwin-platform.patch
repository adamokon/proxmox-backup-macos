+#[cfg(target_os = "macos")]
+fn mkostemp<P: ?Sized + NixPath>(
+    template: &P,
+    oflag: OFlag,
+) -> nix::Result<(std::os::fd::RawFd, PathBuf)> {
+    use std::os::fd::IntoRawFd;
+    use std::os::unix::ffi::OsStringExt;
+    use std::os::unix::fs::OpenOptionsExt;
+    let mut bytes = template.with_nix_path(|name| name.to_bytes().to_owned())?;
+    if !bytes.ends_with(b"XXXXXX") {
+        return Err(Errno::EINVAL);
+    }
+    let offset = bytes.len() - 6;
+    const ALPHABET: &[u8] = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
+    for _ in 0..128 {
+        for byte in &mut bytes[offset..] {
+            *byte = ALPHABET[unsafe { libc::arc4random_uniform(ALPHABET.len() as u32) } as usize];
+        }
+        let path = PathBuf::from(std::ffi::OsString::from_vec(bytes.clone()));
+        // Rust's open uses O_CLOEXEC atomically. create_new adds O_EXCL and
+        // rejects existing symlinks; do not substitute mkstemp + later fcntl.
+        let flags = oflag & (OFlag::O_APPEND | OFlag::O_SYNC);
+        match std::fs::OpenOptions::new()
+            .read(true)
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .custom_flags(flags.bits())
+            .open(&path)
+        {
+            Ok(file) => return Ok((file.into_raw_fd(), path)),
+            Err(error) if error.kind() == io::ErrorKind::AlreadyExists => continue,
+            Err(error) => return Err(Errno::from_raw(error.raw_os_error().unwrap_or(libc::EIO))),
+        }
+    }
+    Err(Errno::EEXIST)
+}
